    "predev": "node scripts/materialize-notebook-outputs.mjs"
  },
  "dependencies": {
    "d3": "7.9.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "vite": "7.1.7"
  },
